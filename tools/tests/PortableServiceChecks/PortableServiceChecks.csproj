<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run the same production services and synthetic checks without WPF.
         Windows/game APIs are not invoked by the default offline checks. -->
    <Compile Include="../../../desktop/WWPoser/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../../../desktop/WWPoser/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../UnifiedServiceChecks/*.cs" Link="Checks/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
