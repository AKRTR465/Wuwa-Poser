<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <AssemblyName>WWPoser</AssemblyName>
    <RootNamespace>WWPoser</RootNamespace>
    <StartupObject>WWPoser.Program</StartupObject>
    <Version>2.6.0</Version>
    <Product>Wuwa Poser</Product>
    <Description>鸣潮 MMD 播放器</Description>
    <RepositoryUrl>https://github.com/AKRTR465/Wuwa-Poser</RepositoryUrl>
    <ApplicationIcon>Assets\WuwaPoser.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\WuwaPoser.ico" />
    <Resource Include="Assets\WuwaPoser.png" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="ServiceChecks" /><InternalsVisibleTo Include="UnifiedUiChecks" /></ItemGroup>
</Project>
